# Development template. Copy it to ".env" and run "php artisan key:generate".
# Never commit a real APP_KEY, database password, SMTP password or API key.
APP_NAME=UXSense
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bahia

# Comma separated list of reverse proxies to trust (or "*")
TRUSTED_PROXIES=
# Comma separated list of allowed CORS origins ("*" allows any origin)
CORS_ALLOWED_ORIGINS=*

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uxsense
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP used by App\Models\Mail (PHPMailer)
MAIL_MAILER=smtp
MAIL_HOST=smtp.uxsense.com.br
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@uxsense.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Cloud Messaging server key used to send push notifications
FCM_SERVER_KEY=
# Shared secret sent in the GSX-CRON-TOKEN header by the cron that calls /api/push/check
PUSH_CHECK_TOKEN=

VITE_APP_NAME="${APP_NAME}"
